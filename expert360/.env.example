# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SKIP_WA_AUTO_CONNECT: Set to "true" to bypass live WhatsApp auto-connect at startup.
# Helps avoid connection hangs or writing directory issues in non-interactive builds/deployments.
SKIP_WA_AUTO_CONNECT="false"

# TELEGRAM_BOT_TOKEN: The HTTP API token received from BotFather for your Telegram Bot.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_BOT_USERNAME: The username of your Telegram Bot without the @ symbol.
TELEGRAM_BOT_USERNAME="expertecom_bot"

# SUPERADMIN_WALLET: Your real TON wallet address to receive payments and unallocated MLM commissions
SUPERADMIN_WALLET=""

# SUPERADMIN_MNEMONIC: Your 24-word seed phrase (space separated) for the SuperAdmin wallet.
# REQUIRED for automatic real crypto dispersion. NEVER share this with anyone.
SUPERADMIN_MNEMONIC=""

# EVOLUTION_API_URL: Public HTTPS URL for your Evolution API instance on your VPS.
EVOLUTION_API_URL="https://whatsapp.xorbit360.com"

# EVOLUTION_API_KEY: Global API Key for authenticating with Evolution API.
EVOLUTION_API_KEY=""

# SUPABASE_URL: Project URL from your Supabase project settings (e.g. https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_KEY: Supabase API Key (anon key or service_role key with admin write permissions)
SUPABASE_KEY=""

# ZERNIO_API_KEY: Permanent API Bearer Token for Zernio Meta Cloud API (https://zernio.com/api/v1)
ZERNIO_API_KEY=""

# ZERNIO_WEBHOOK_SECRET: Shared secret to verify HMAC SHA256 X-Zernio-Signature of inbound webhooks
ZERNIO_WEBHOOK_SECRET=""

# ZERNIO_SWEEPER_SECRET: Secret token to protect the recovery sweeper endpoint (/api/zernio/webhook/sweeper)
ZERNIO_SWEEPER_SECRET=""
